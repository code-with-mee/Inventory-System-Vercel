# Copy to .env for local development, or set these in the Vercel dashboard.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# "True" only for local development; keep False in production.
DEBUG=False

# Hosted Postgres connection string (use the POOLED endpoint).
# Leave unset locally to fall back to SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Optional: comma-separated extra hosts / CSRF origins for custom domains.
# ALLOWED_HOSTS=example.com
# CSRF_TRUSTED_ORIGINS=https://example.com
